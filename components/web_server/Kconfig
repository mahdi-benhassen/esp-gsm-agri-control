menu "Web Server Configuration"

    config WEB_SERVER_ENABLED
        bool "Enable Web Server"
        default y
        help
            Enable embedded HTTP web server and WiFi manager.

    config WEB_SERVER_PORT
        int "Web Server HTTP Port"
        default 80

    config WEB_SERVER_WIFI_AP_SSID
        string "WiFi AP SSID (setup mode)"
        default "KC868-A2v3-Setup"

    config WEB_SERVER_WIFI_AP_PASSWORD
        string "WiFi AP Password (setup mode, min 8 chars)"
        default "admin1234"

    config WEB_SERVER_AUTH_USERNAME
        string "Web UI Username"
        default "admin"
        help
            HTTP Basic Auth username for the web interface.

    config WEB_SERVER_AUTH_PASSWORD
        string "Web UI Password"
        default "admin"
        help
            HTTP Basic Auth password for the web interface.
            CHANGE THIS BEFORE DEPLOYMENT.

    config WEB_SERVER_RATE_LIMIT_MS
        int "API Rate Limit (ms between requests)"
        default 500
        help
            Global minimum time between authenticated API requests.

endmenu
